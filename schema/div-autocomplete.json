        "dismiss_on_empty": {
          "$ref": "common.json#/boolean_int",
          "default_value": "true",
          "$description": "translations.json#/div_autocomplete_dismiss_on_empty"
        },
        "suggestion_text_color": {
          "$ref": "common.json#/color",
          "default_value": "#FF000000",
